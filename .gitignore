# Byte-compiled / optimized / DLLs
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual Environment
venv/
env/
.env

# Large raw datasets & outputs (optional, retain structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/*
!reports/.gitkeep

# Admissions Data (Sensitive / PDPA)
admissions/data/raw/applicants/*
!admissions/data/raw/applicants/.gitkeep
admissions/data/processed/*
!admissions/data/processed/.gitkeep
admissions/reports/*
!admissions/reports/.gitkeep